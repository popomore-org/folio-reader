#!/usr/bin/env bash
set -euo pipefail

tag="${1:?Supply a release tag}"
[[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "Expected a stable vX.Y.Z tag." >&2
  exit 1
}
version="${tag#v}"
scripts/macos-version "$version" > /dev/null
sha="$(git rev-parse --verify "refs/tags/$tag^{commit}")"
git merge-base --is-ancestor "$sha" origin/main || {
  echo "The tagged commit must be on main." >&2
  exit 1
}
printf 'tag=%s\nversion=%s\nsource-sha=%s\n' "$tag" "$version" "$sha"
