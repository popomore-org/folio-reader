#!/usr/bin/env bash
set -euo pipefail

tag="${1:?Supply a release tag}"
if [[ "$tag" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  version="${BASH_REMATCH[1]}"
  channel=stable
  scripts/macos-version "$version" > /dev/null
elif [[ "$tag" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)\.([1-9][0-9]{0,11})-([0-9a-f]{7})$ ]]; then
  base="${BASH_REMATCH[1]}"
  timestamp="${BASH_REMATCH[2]}"
  short_sha="${BASH_REMATCH[3]}"
  version="$base-$timestamp.g$short_sha"
  channel=timestamp
  scripts/macos-version "$base" "$timestamp-$short_sha" > /dev/null
else
  echo "Expected a stable or timestamped Folio release tag." >&2
  exit 1
fi
sha="$(git rev-parse --verify "refs/tags/$tag^{commit}")"
git merge-base --is-ancestor "$sha" origin/main || {
  echo "The tagged commit must be on main." >&2
  exit 1
}
if [[ "$channel" == timestamp ]]; then
  test "$(git show -s --format=%ct "$sha")-${sha:0:7}" = "$timestamp-$short_sha"
fi
printf 'tag=%s\nversion=%s\nsource-sha=%s\nchannel=%s\n' "$tag" "$version" "$sha" "$channel"
