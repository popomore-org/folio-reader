#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
: "${GH_TOKEN:?Configure distribution credentials}"
: "${FOLIO_RELEASE_REPOSITORY:?Set the distribution repository}"
repo="repos/$FOLIO_RELEASE_REPOSITORY"
version="${1:?Supply the version}"
channel="${FOLIO_RELEASE_CHANNEL:-stable}"
tag="${FOLIO_TAG:-v$version}"
case "$channel" in
  timestamp)
    [[ "$tag" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)\.([1-9][0-9]{0,11})-([0-9a-f]{7})$ ]]
    test "$version" = "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}.g${BASH_REMATCH[3]}"
    stem="Folio-Preview-$version-arm64"
    assets=("$stem.zip" "$stem.dmg" "$stem.dmg.sha256" appcast.xml)
    prerelease=true
    ;;
  stable)
    test "$tag" = "v$version"
    current_build="$(scripts/macos-version "$version")"
    assets=("Folio-$version.zip" "Folio-$version.dmg" appcast.xml)
    prerelease=false
    ;;
  *) echo "Unsupported release channel." >&2; exit 1 ;;
esac
mode="${3:-promote}"
id="${2:?Supply the staged release ID}"
[[ "$id" =~ ^[0-9]+$ ]]
metadata=$(gh api "$repo")
jq -e '.private == true' <<< "$metadata" > /dev/null

receipt=$(gh api "$repo/releases/$id")
jq -e --arg tag "$tag" --argjson prerelease "$prerelease" \
  '.tag_name == $tag and (.prerelease == $prerelease or ($prerelease and .draft == true and .prerelease == false))' \
  <<< "$receipt" > /dev/null
verification=$(mktemp -d "${TMPDIR:-/tmp}/folio-verify.XXXXXX")
trap 'rm -rf "$verification"' EXIT
[[ "$mode" == promote || "$mode" == resume ]]
for name in "${assets[@]}"; do
  asset=$(jq -ce --arg name "$name" '.assets[] | select(.name == $name)' <<< "$receipt")
  asset_id=$(jq -er .id <<< "$asset")
  digest=$(jq -er .digest <<< "$asset")
  gh api "$repo/releases/assets/$asset_id" -H 'Accept: application/octet-stream' > "$verification/$name"
  test "$digest" = "sha256:$(shasum -a 256 "$verification/$name" | cut -d' ' -f1)"
  if [[ "$mode" == promote ]]; then
    cmp "dist/$name" "$verification/$name"
  fi
done
if jq -e '.draft == true' <<< "$receipt" > /dev/null; then
  gh api "$repo/releases/$id" --method PATCH -F draft=false -F prerelease="$prerelease" -f make_latest=false --jq .html_url
fi
published=$(gh api "$repo/releases/$id")
jq -e --argjson prerelease "$prerelease" \
  '.draft == false and .prerelease == $prerelease and .immutable == true' <<< "$published" > /dev/null
for name in "${assets[@]}"; do
  asset_id=$(jq -er --arg name "$name" '.assets[] | select(.name == $name).id' <<< "$published")
  gh api "$repo/releases/assets/$asset_id" -H 'Accept: application/octet-stream' > "$verification/download"
  cmp "$verification/$name" "$verification/download"
done
if [[ "$channel" == timestamp ]]; then
  exit 0
fi
if latest=$(gh api "$repo/releases/latest" 2>&1); then
  latest_version=$(jq -er '.tag_name | select(startswith("v")) | ltrimstr("v")' <<< "$latest")
  latest_build="$(scripts/macos-version "$latest_version")"
  comparison=$(python3 - "$current_build" "$latest_build" <<'PYTHON'
import sys
def numbers(value):
    return tuple(map(int, value.split(".")))
first, second = map(numbers, sys.argv[1:])
print((first > second) - (first < second))
PYTHON
  )
  if [[ "$comparison" == -1 ]]; then
    echo "Versioned assets verified. The stable channel already has a newer version."
    exit 0
  fi
elif [[ "$latest" != *"HTTP 404"* ]]; then
  printf '%s\n' "$latest" >&2
  exit 1
fi
gh api "$repo/releases/$id" --method PATCH -f make_latest=true --jq .html_url
latest=$(gh api "$repo/releases/latest")
jq -e --argjson id "$id" '.id == $id and .immutable == true' <<< "$latest" > /dev/null
asset_id=$(jq -er '.assets[] | select(.name == "appcast.xml").id' <<< "$latest")
gh api "$repo/releases/assets/$asset_id" -H 'Accept: application/octet-stream' > "$verification/latest.xml"
cmp "$verification/appcast.xml" "$verification/latest.xml"
