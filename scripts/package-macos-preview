#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
umask 077

repository="${FOLIO_RELEASE_REPOSITORY:?Set the private distribution repository}"
tag="${FOLIO_TAG:?Set the validated preview tag}"
artifact_version="${FOLIO_VERSION:?Set the validated artifact version}"
[[ "$repository" =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]]
[[ "$tag" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)\.([1-9][0-9]{0,11})-([0-9a-f]{7})$ ]]
export FOLIO_VERSION="${BASH_REMATCH[1]}"
export FOLIO_PREVIEW_SUFFIX="${BASH_REMATCH[2]}-${BASH_REMATCH[3]}"
test "$artifact_version" = "$FOLIO_VERSION-${FOLIO_PREVIEW_SUFFIX/-/.g}"
export FOLIO_UPDATE_FEED="https://github.com/$repository/releases/download/$tag/appcast.xml"
: "${FOLIO_UPDATE_PUBLIC_KEY:?Pin the preview channel’s Ed25519 public key}"
: "${FOLIO_UPDATE_PRIVATE_KEY:?Configure the preview channel’s Ed25519 seed}"
test "$FOLIO_UPDATE_PUBLIC_KEY" = "$(printf '%s\n' "$FOLIO_UPDATE_PRIVATE_KEY" | xcrun swift scripts/macos-update-key.swift)"

stage=$(mktemp -d "${TMPDIR:-/tmp}/folio-preview.XXXXXX")
trap 'rm -rf "$stage"' EXIT
printf '%s\n' "$FOLIO_UPDATE_PRIVATE_KEY" > "$stage/sparkle"
unset FOLIO_UPDATE_PRIVATE_KEY

bundle=$(scripts/build-macos preview-release)
test "$(lipo -archs "$bundle/Contents/MacOS/Folio")" = arm64
test "$(plutil -extract CFBundleIdentifier raw "$bundle/Contents/Info.plist")" = org.popomore.folio.preview
scripts/check-quicklook "$bundle"

stem="Folio-Preview-$artifact_version-arm64"
mkdir -p dist "$stage/dmg"
rm -f "dist/$stem.zip" "dist/$stem.dmg"
ditto -c -k --keepParent "$bundle" "dist/$stem.zip"
ditto "$bundle" "$stage/dmg/Folio.app"
ln -s /Applications "$stage/dmg/Applications"
hdiutil create -volname Folio -srcfolder "$stage/dmg" -format UDZO "dist/$stem.dmg"
hdiutil verify -quiet "dist/$stem.dmg"
(cd dist && shasum -a 256 "$stem.dmg" > "$stem.dmg.sha256")
scripts/macos-appcast "$FOLIO_VERSION" "dist/$stem.zip" \
  "https://github.com/$repository/releases/download/$tag/$stem.zip" \
  .release/preview-notes.txt dist/appcast.xml "$stage/sparkle"
